# Mutation plan for GET /users/email/{email} (getUserByEmail).
#
#   scripts/mutate-batch.sh scripts/mutations/user-by-email.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
#
# This handler is the odd one of the three single-user reads: no terms-of-service branch and no
# `is_self` case in the sanitiser.  Two of the mutations below *add* those back, because the
# likeliest wrong port here is the tidy one that reuses `respond_with_user`.
#
# `api-email-option-gate` only inverts the gate's polarity.  Removing it outright is **inert**
# on this deployment: `ShowEmailAddress` is on, so the option is true and the refusing side of
# the branch is unreachable.  Inverting it makes every request a 403, which at least pins that
# the gate reads the `email` option and not some constant.
#
# `control-rename-binding` covers the binding's whole life, tail included.  An earlier version
# renamed it on the declaration only and the crate did not compile, which reports a harness fault
# and throws away every other verdict in the run.  Twice.
#
# The last two lines are the no-op controls and must SURVIVE.

store-email-column	crates/mm-store/src/user_store.rs	             WHERE u.email = lower($1)	             WHERE u.username = lower($1)	api	user_by_email
store-lower-the-column	crates/mm-store/src/user_store.rs	             WHERE u.email = lower($1)	             WHERE lower(u.email) = $1	api	user_by_email
app-notfound-id	crates/mm-app/src/user.rs	                    "GetUserByEmail",\n                    "app.user.missing_account.const",	                    "GetUserByEmail",\n                    "app.user.get_by_email.app_error",	api	user_by_email
app-notfound-status	crates/mm-app/src/user.rs	            .get_by_email(email)\n            .await\n            .map_err(|err| {\n                let status = if matches!(err, StoreError::NotFound { .. }) {\n                    404	            .get_by_email(email)\n            .await\n            .map_err(|err| {\n                let status = if matches!(err, StoreError::NotFound { .. }) {\n                    500	api	user_by_email
api-lowercase-the-segment	crates/mm-api/src/users.rs	    let email = go_to_lower(&email);\n    if !mm_model::utils::is_valid_email(&email) {	    if !mm_model::utils::is_valid_email(&email) {	api	user_by_email
api-address-validation	crates/mm-api/src/users.rs	    if !mm_model::utils::is_valid_email(&email) {\n        return ApiError::invalid_url_param("email").into_response();\n    }	    if false {\n        return ApiError::invalid_url_param("email").into_response();\n    }	api	user_by_email
api-email-option-gate	crates/mm-api/src/users.rs	    if options.get("email") != Some(&true) {	    if options.get("email") == Some(&true) {	api	user_by_email
api-sanitiser-admin-flag	crates/mm-api/src/users.rs	    // No `is_self` branch — see the note above.\n    user.sanitize_profile(&options, is_admin);	    // No `is_self` branch — see the note above.\n    user.sanitize_profile(&options, true);	api	user_by_email
api-adds-the-is-self-branch	crates/mm-api/src/users.rs	    // No `is_self` branch — see the note above.\n    user.sanitize_profile(&options, is_admin);	    // No `is_self` branch — see the note above.\n    if session.0.user_id == user.id {\n        user.sanitize(&HashMap::new());\n    } else {\n        user.sanitize_profile(&options, is_admin);\n    }	api	user_by_email
api-etag-privacy-inputs	crates/mm-api/src/users.rs	    let etag = user.etag(state.show_full_name(), state.show_email_address());\n    if let Some(if_none_match) = headers.get(IF_NONE_MATCH).and_then(|v| v.to_str().ok())\n        && if_none_match == etag\n    {\n        return (StatusCode::NOT_MODIFIED, [(ETAG, etag)]).into_response();\n    }	    let etag = user.etag(state.show_full_name(), state.show_email_address());\n    if false {\n        return (StatusCode::NOT_MODIFIED, [(ETAG, etag.clone())]).into_response();\n    }	api	user_by_email
api-trailing-newline	crates/mm-api/src/users.rs	    body.push(b'\\n');\n\n    (\n        StatusCode::OK,\n        [\n            (HEADER_ETAG_SERVER, etag.as_str()),\n            ("Content-Type", "application/json"),\n            ("x-mmrs-served-by", "rust"),\n        ],\n        body,\n    )\n        .into_response()\n}	    (\n        StatusCode::OK,\n        [\n            (HEADER_ETAG_SERVER, etag.as_str()),\n            ("Content-Type", "application/json"),\n            ("x-mmrs-served-by", "rust"),\n        ],\n        body,\n    )\n        .into_response()\n}	api	user_by_email
#
# --- no-op controls: these must SURVIVE ---
control-rename-binding	crates/mm-api/src/users.rs	    let mut body = match serde_json::to_vec(&user) {\n        Ok(body) => body,\n        Err(err) => {\n            tracing::error!(error = %err, "failed to serialise User");\n            return ApiError::from(AppError::boxed(\n                "getUserByEmail",\n                "api.marshal_error",\n                None,\n                String::new(),\n                500,\n            ))\n            .into_response();\n        }\n    };\n    body.push(b'\\n');\n\n    (\n        StatusCode::OK,\n        [\n            (HEADER_ETAG_SERVER, etag.as_str()),\n            ("Content-Type", "application/json"),\n            ("x-mmrs-served-by", "rust"),\n        ],\n        body,\n    )	    let mut encoded = match serde_json::to_vec(&user) {\n        Ok(body) => body,\n        Err(err) => {\n            tracing::error!(error = %err, "failed to serialise User");\n            return ApiError::from(AppError::boxed(\n                "getUserByEmail",\n                "api.marshal_error",\n                None,\n                String::new(),\n                500,\n            ))\n            .into_response();\n        }\n    };\n    encoded.push(b'\\n');\n\n    (\n        StatusCode::OK,\n        [\n            (HEADER_ETAG_SERVER, etag.as_str()),\n            ("Content-Type", "application/json"),\n            ("x-mmrs-served-by", "rust"),\n        ],\n        encoded,\n    )	api	user_by_email
control-reorder-columns	crates/mm-store/src/user_store.rs	            SELECT u.id,\n                   u.createat,\n                   u.updateat,\n                   u.deleteat,\n                   u.username,\n                   u.password,\n                   u.authdata,\n                   u.authservice,\n                   u.email,\n                   u.emailverified,\n                   u.nickname,\n                   u.firstname,\n                   u.lastname,\n                   u.position,\n                   u.roles,\n                   u.allowmarketing,\n                   u.props,\n                   u.notifyprops,\n                   u.lastpasswordupdate,\n                   u.lastpictureupdate,\n                   u.failedattempts::bigint AS failedattempts,\n                   u.locale,\n                   u.timezone,\n                   u.mfaactive,\n                   u.mfasecret,\n                   u.mfausedtimestamps,\n                   u.remoteid,\n                   u.lastlogin,\n                   (b.userid IS NOT NULL) AS "isbot!",\n                   COALESCE(b.description, '') AS "botdescription!",\n                   COALESCE(b.lasticonupdate, 0) AS "botlasticonupdate!"\n              FROM users u\n              LEFT JOIN bots b ON b.userid = u.id\n             WHERE u.email = lower($1)	            SELECT u.createat,\n                   u.id,\n                   u.updateat,\n                   u.deleteat,\n                   u.username,\n                   u.password,\n                   u.authdata,\n                   u.authservice,\n                   u.email,\n                   u.emailverified,\n                   u.nickname,\n                   u.firstname,\n                   u.lastname,\n                   u.position,\n                   u.roles,\n                   u.allowmarketing,\n                   u.props,\n                   u.notifyprops,\n                   u.lastpasswordupdate,\n                   u.lastpictureupdate,\n                   u.failedattempts::bigint AS failedattempts,\n                   u.locale,\n                   u.timezone,\n                   u.mfaactive,\n                   u.mfasecret,\n                   u.mfausedtimestamps,\n                   u.remoteid,\n                   u.lastlogin,\n                   (b.userid IS NOT NULL) AS "isbot!",\n                   COALESCE(b.description, '') AS "botdescription!",\n                   COALESCE(b.lasticonupdate, 0) AS "botlasticonupdate!"\n              FROM users u\n              LEFT JOIN bots b ON b.userid = u.id\n             WHERE u.email = lower($1)	api	user_by_email
