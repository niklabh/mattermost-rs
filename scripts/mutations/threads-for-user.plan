# Mutation plan for GET /users/{user_id}/teams/{team_id}/threads (getThreadsForUser).
#
#   scripts/mutate-batch.sh scripts/mutations/threads-for-user.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
#
# thread_store.rs repeats `channelMembershipPredicate` and the team filter in all five queries,
# exactly as Go does — so an anchor on either alone is ambiguous. Each line below carries enough
# of its own query to be unique; the counters are told apart by their SELECT.
#
# Seven survivors on the first run, and every one was a branch the fixture never reached: no
# thread carried a `PostsPriority` row (so the urgency CASE, the urgent counter and the config
# flag were all dead), none had `Following = false`, none had `LastViewed` exactly equal to
# `LastReplyAt`, and none had a deleted reply. A second actor now carries all four, plus a third
# for the attachments post — which has to be alone, because forwarding is per page.
#
# The last two lines are the no-op controls and must SURVIVE.
store-following-flag	crates/mm-store/src/thread_store.rs	             WHERE tm.userid = $1\n               AND tm.following = TRUE\n               AND (COALESCE(t.threadteamid, '') = ''\n                    OR EXISTS (SELECT 1\n                                 FROM channelmembers cm\n                                WHERE cm.channelid = t.channelid\n                                  AND cm.userid = tm.userid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	             WHERE tm.userid = $1\n               AND tm.following IS NOT NULL\n               AND (COALESCE(t.threadteamid, '') = ''\n                    OR EXISTS (SELECT 1\n                                 FROM channelmembers cm\n                                WHERE cm.channelid = t.channelid\n                                  AND cm.userid = tm.userid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	api	threads_for_user
store-channel-membership-predicate	crates/mm-store/src/thread_store.rs	                    OR EXISTS (SELECT 1\n                                 FROM channelmembers cm\n                                WHERE cm.channelid = t.channelid\n                                  AND cm.userid = tm.userid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	                    OR TRUE)\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	api	threads_for_user
store-membership-subject	crates/mm-store/src/thread_store.rs	                                WHERE cm.channelid = t.channelid\n                                  AND cm.userid = tm.userid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	                                WHERE cm.channelid = t.channelid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	api	threads_for_user
store-order-direction	crates/mm-store/src/thread_store.rs	             ORDER BY t.lastreplyat DESC\n             LIMIT $4	             ORDER BY t.lastreplyat ASC\n             LIMIT $4	api	threads_for_user
store-page-size	crates/mm-store/src/thread_store.rs	             ORDER BY t.lastreplyat DESC\n             LIMIT $4	             ORDER BY t.lastreplyat DESC\n             LIMIT LEAST($4, 1::bigint)	api	threads_for_user
store-unread-replies-cutoff	crates/mm-store/src/thread_store.rs	                       AND r.createat > tm.lastviewed\n	                       AND r.createat >= 0\n	api	threads_for_user
store-unread-replies-deleted	crates/mm-store/src/thread_store.rs	                       AND r.createat > tm.lastviewed\n                       AND r.deleteat = 0)	                       AND r.createat > tm.lastviewed\n                       AND r.deleteat >= 0)	api	threads_for_user
store-urgent-coalesce	crates/mm-store/src/thread_store.rs	COALESCE($3 AND pp.priority = 'urgent', FALSE) AS "isurgent!"	COALESCE($3 AND pp.priority <> 'urgent', FALSE) AS "isurgent!"	api	threads_for_user
store-unread-threads-predicate	crates/mm-store/src/thread_store.rs	               AND tm.lastviewed < t.lastreplyat\n	               AND tm.lastviewed <= t.lastreplyat\n	api	threads_for_user
store-mentions-sum-column	crates/mm-store/src/thread_store.rs	SELECT COALESCE(SUM(tm.unreadmentions), 0)::bigint AS "sum!"\n              FROM threadmemberships tm\n              LEFT JOIN threads t	SELECT COALESCE(SUM(tm.lastviewed), 0)::bigint AS "sum!"\n              FROM threadmemberships tm\n              LEFT JOIN threads t	api	threads_for_user
store-urgent-counter-priority	crates/mm-store/src/thread_store.rs	               AND pp.priority = 'urgent'\n	               AND pp.priority <> 'urgent'\n	api	threads_for_user
app-post-priority-flag	crates/mm-app/src/thread.rs	let include_is_urgent = self.config().post_priority;	let include_is_urgent = !self.config().post_priority;	api	threads_for_user
app-extended-hydration	crates/mm-app/src/thread.rs	        if extended {\n            self.hydrate_thread_participants(&mut threads).await?;\n        }	        if false {\n            self.hydrate_thread_participants(&mut threads).await?;\n        }	api	threads_for_user
app-post-sanitisation	crates/mm-app/src/thread.rs	            if let Some(post) = thread.post.as_mut() {\n                post.sanitize_props();\n                post.strip_action_integrations();\n            }	            if let Some(post) = thread.post.as_mut() {\n                let _ = post;\n            }	api	threads_for_user
api-forward-list	crates/mm-api/src/users.rs	const THREADS_FORWARDED_PARAMS: &[&str] = &[\n    "since",	const THREADS_FORWARDED_PARAMS: &[&str] = &[\n    "sinceX",	api	threads_for_user
api-forward-check	crates/mm-api/src/users.rs	    if THREADS_FORWARDED_PARAMS\n        .iter()\n        .any(|name| query_first(query.as_deref(), name).is_some())\n    {	    if false {	api	threads_for_user
api-extended-flag	crates/mm-api/src/users.rs	let extended = query_flag_is_true(query, "extended");	let extended = query_flag_is_true(query, "extend");	api	threads_for_user
api-user-gate	crates/mm-api/src/users.rs	        .session_has_permission_to_user(&session.0, user_id)\n        .await\n    {\n        return Err(ApiError::from(make_permission_error(\n            &session.0,\n            &[&PERMISSION_EDIT_OTHER_USERS],\n        )));\n    }\n    if !state	        .session_has_permission_to_user(&session.0, user_id)\n        .await\n        && false\n    {\n        return Err(ApiError::from(make_permission_error(\n            &session.0,\n            &[&PERMISSION_EDIT_OTHER_USERS],\n        )));\n    }\n    if !state	api	threads_for_user
api-team-gate	crates/mm-api/src/users.rs	        .session_has_permission_to_team(&session.0, team_id, &PERMISSION_VIEW_TEAM)\n        .await\n    {	        .session_has_permission_to_team(&session.0, team_id, &PERMISSION_VIEW_TEAM)\n        .await\n        && false\n    {	api	threads_for_user
api-participant-sanitisation	crates/mm-api/src/users.rs	        for participant in thread.participants.iter_mut().flatten() {\n            participant.sanitize_profile(&options, false);\n        }	        for participant in thread.participants.iter_mut().flatten() {\n            let _ = participant;\n        }	api	threads_for_user
api-trailing-newline	crates/mm-api/src/users.rs	    let mut body = serde_json::to_vec(&threads).map_err(|err| {\n        tracing::error!(error = %err, "failed to serialise the threads");\n        marshal_error("getThreadsForUser")\n    })?;\n    body.push(b'\\n');	    let body = serde_json::to_vec(&threads).map_err(|err| {\n        tracing::error!(error = %err, "failed to serialise the threads");\n        marshal_error("getThreadsForUser")\n    })?;	api	threads_for_user
#
# --- no-op controls: these must SURVIVE ---
control-rename-binding	crates/mm-app/src/thread.rs	        let wrap = |err: mm_store::error::StoreError| {\n            tracing::error!(error = %err, "threads lookup failed");	        let wrap = |cause: mm_store::error::StoreError| {\n            tracing::error!(error = %cause, "threads lookup failed");	api	threads_for_user
control-reorder-predicates	crates/mm-store/src/thread_store.rs	             WHERE tm.userid = $1\n               AND tm.following = TRUE\n               AND (COALESCE(t.threadteamid, '') = ''\n                    OR EXISTS (SELECT 1\n                                 FROM channelmembers cm\n                                WHERE cm.channelid = t.channelid\n                                  AND cm.userid = tm.userid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	             WHERE tm.following = TRUE\n               AND tm.userid = $1\n               AND (COALESCE(t.threadteamid, '') = ''\n                    OR EXISTS (SELECT 1\n                                 FROM channelmembers cm\n                                WHERE cm.channelid = t.channelid\n                                  AND cm.userid = tm.userid))\n               AND (COALESCE(t.threadteamid, '') = $2\n                    OR COALESCE(t.threadteamid, '') = '')\n               AND COALESCE(t.threaddeleteat, 0) = 0\n             ORDER BY t.lastreplyat DESC	api	threads_for_user
