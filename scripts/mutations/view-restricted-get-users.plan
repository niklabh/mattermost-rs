# GET /users for a view-restricted caller: the all, in-team, not-in-channel and not-in-team arms (2026-09-28).
#   scripts/mutations/view-restricted-get-users.plan
all-channel-filter-dropped	crates/mm-store/src/user_store.rs	                        AND rcm.channelid = ANY($6::text[])))\n             ORDER BY u.username ASC\n             OFFSET $1 LIMIT $2	                        AND (rcm.channelid = ANY($6::text[]) OR true)))\n             ORDER BY u.username ASC\n             OFFSET $1 LIMIT $2	api	a_restricted_callers_searches_and_lists_are_gos
in-team-channel-filter-dropped	crates/mm-store/src/user_store.rs	                        AND rcm.channelid = ANY($7::text[])))\n             ORDER BY u.username ASC\n             OFFSET $2 LIMIT $3	                        AND (rcm.channelid = ANY($7::text[]) OR true)))\n             ORDER BY u.username ASC\n             OFFSET $2 LIMIT $3	api	a_restricted_callers_searches_and_lists_are_gos
not-in-channel-channel-filter-dropped	crates/mm-store/src/user_store.rs	                        AND rcm.channelid = ANY($7::text[])))\n             ORDER BY u.username ASC\n             OFFSET $3 LIMIT $4	                        AND (rcm.channelid = ANY($7::text[]) OR true)))\n             ORDER BY u.username ASC\n             OFFSET $3 LIMIT $4	api	a_restricted_callers_searches_and_lists_are_gos
not-in-team-channel-filter-dropped	crates/mm-store/src/user_store.rs	                        AND rcm.channelid = ANY($6::text[])))\n             ORDER BY u.username ASC\n             OFFSET $2 LIMIT $3	                        AND (rcm.channelid = ANY($6::text[]) OR true)))\n             ORDER BY u.username ASC\n             OFFSET $2 LIMIT $3	api	a_restricted_callers_searches_and_lists_are_gos
etag-hash-dropped	crates/mm-api/src/users.rs	        .map(ViewUsersRestrictions::hash)	        .map(|_| String::new())	api	a_restricted_callers_searches_and_lists_are_gos
handler-drops-restrictions	crates/mm-api/src/users.rs	        GetUsersVariant::Http,\n        restrictions.as_ref(),	        GetUsersVariant::Http,\n        restrictions.as_ref().filter(|_| false),	api	a_restricted_callers_searches_and_lists_are_gos
CONTROL-alias-rename	crates/mm-store/src/user_store.rs	                     SELECT 1 FROM channelmembers rcm\n                      WHERE rcm.userid = u.id\n                        AND rcm.channelid = ANY($6::text[])))\n             ORDER BY u.username ASC\n             OFFSET $1 LIMIT $2	                     SELECT 1 FROM channelmembers rcx\n                      WHERE rcx.userid = u.id\n                        AND rcx.channelid = ANY($6::text[])))\n             ORDER BY u.username ASC\n             OFFSET $1 LIMIT $2	api	a_restricted_callers_searches_and_lists_are_gos
CONTROL-where-reorder	crates/mm-store/src/user_store.rs	             WHERE tm.userid IS NULL\n               AND NOT $4::boolean\n	             WHERE NOT $4::boolean\n               AND tm.userid IS NULL\n	api	a_restricted_callers_searches_and_lists_are_gos
