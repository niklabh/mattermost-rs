# Mutation plan for the two feature-flagged "mark everything read" writes —
#   `PUT /channels/members/{user_id}/direct/read` and `PUT /users/{user_id}/teams/{team_id}/read`.
#
#   scripts/mutate-batch.sh scripts/mutations/channel-read-all.plan
#
# Companion to `channel-view.plan`, which covers the machinery these two share. Only what is
# *different* about them is here: two more queries, the thread statement they both run
# unconditionally, the two differently-scoped thread events, and the feature-flag gate.
#
# The `api` lines need both servers running with
# `MM_FEATUREFLAGS_ENABLESHIFTESCAPETOMARKALLREAD=true`, which `scripts/go-server.sh` and
# `scripts/mm-api-env.sh` now set; without it every route under test answers 501 and every
# mutation is reported CAUGHT for the wrong reason.

readall-team-query-has-no-deny-list	crates/mm-store/src/channel_store.rs	         WHERE channels.teamid = $1\n           AND channelmembers.userid = $2\n           AND channels.type <> 'S'	         WHERE channels.teamid = $1\n           AND channelmembers.userid = $2\n           AND TRUE	store	store_channel_view
readall-team-query-is-not-team-scoped	crates/mm-store/src/channel_store.rs	         WHERE channels.teamid = $1\n           AND channelmembers.userid = $2	         WHERE ($1 = $1)\n           AND channelmembers.userid = $2	store	store_channel_view
readall-direct-query-allows-open-channels	crates/mm-store/src/channel_store.rs	           AND channels.type IN ('D', 'G')	           AND channels.type IN ('D', 'G', 'O', 'BO')	store	store_channel_view
readall-direct-query-drops-direct-channels	crates/mm-store/src/channel_store.rs	           AND channels.type IN ('D', 'G')	           AND channels.type IN ('G')	store	store_channel_view
thread-mark-read-ignores-lastreplyat	crates/mm-store/src/thread_store.rs	               AND threads.lastreplyat > threadmemberships.lastviewed	               AND TRUE	store	store_thread_mark_read
thread-mark-read-ignores-the-channel-list	crates/mm-store/src/thread_store.rs	               AND threads.channelid = ANY($3)	               AND (threads.channelid = ANY($3) OR TRUE)	store	store_thread_mark_read
thread-mark-read-does-not-clear-mentions	crates/mm-store/src/thread_store.rs	                   unreadmentions = 0,	                   unreadmentions = threadmemberships.unreadmentions,	store	store_thread_mark_read
thread-mark-read-lastupdated-is-left-alone	crates/mm-store/src/thread_store.rs	                   lastupdated = $1	                   lastupdated = threadmemberships.lastupdated	store	store_thread_mark_read
thread-mark-read-joins-on-channel-not-post	crates/mm-store/src/thread_store.rs	               AND threads.postid = threadmemberships.postid	               AND TRUE	store	store_thread_mark_read
