# Mutation plan for the twelve routes' system posts (D-231, D-232, D-233).
#
#   scripts/mutate-batch.sh scripts/mutations/system-posts.plan
#
# Every line here targets a decision that is invisible to the route that makes it. None of the
# twelve routes shows a system post in its response body, so each of these mutations leaves every
# status code and every byte of every body exactly as it was; only `parity/system_posts.rs`, which
# reads the timeline back, can tell.
#
# The four groups:
#
#   * the store's counter update — whether a join counts as a message, and which way `GREATEST`
#     goes. Getting the first wrong makes every join unread; getting the second wrong stops the
#     channel moving in the sidebar at all.
#   * which of the four membership posts is written, which is decided by *who asked* and not by
#     what changed.
#   * the props keys and the author, which are the whole wire contract — a client renders its own
#     sentence from `props` and ignores `message`.
#   * the `posted` event's six data fields.
#
# The last two lines are the no-op controls and must SURVIVE.
system-post-always-counts-as-a-message	crates/mm-store/src/post_store.rs	let count = i64::from(!post.excludes_from_channel_message_count());	let count = i64::from(true);	api	a_join_post_moves_last_post_at
system-post-never-counts-as-a-message	crates/mm-store/src/post_store.rs	let count = i64::from(!post.excludes_from_channel_message_count());	let count = i64::from(false);	api	a_join_post_moves_last_post_at
last-post-at-takes-the-least-not-the-greatest	crates/mm-store/src/post_store.rs	SET lastpostat        = GREATEST($1, lastpostat),	SET lastpostat        = LEAST($1, lastpostat),	api	a_join_post_moves_last_post_at
the-channel-counter-update-matches-no-row	crates/mm-store/src/post_store.rs	WHERE id = $3\n            "#,	WHERE id = $3 AND 1 = 0\n            "#,	api	a_join_post_moves_last_post_at
