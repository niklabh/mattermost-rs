# Mutation plan for POST /teams/{team_id}/channels/search (searchChannelsForTeam).
#
#   scripts/mutate-batch.sh scripts/mutations/channel-search.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
#
# The fixture carries one channel per branch the queries can take: joined-open, unjoined-open,
# private-and-joined (never a result, because both queries join `PublicChannels`) and archived
# (a result, because `includeDeleted` is a literal `true`).  Without the private one the
# `publicchannels` join is indistinguishable from a `channels` one; without the archived one the
# missing `DeleteAt = 0` predicate is invisible.
#
# `store-membership-subject` was dropped: `search_for_user_in_team` is **unreachable** through
# this route.  `list_team_channels` is granted by `team_user`, which every team membership
# carries, so a team member is always a lister and the second branch never runs.  The only way to
# strip the permission is to rewrite roles behind a live session, and Go's session cache then
# disagrees with the database — a state the REST API cannot produce.
#
# A SQL mutation must keep every bound parameter used — sqlx refuses an unused one.  A control
# must cover its binding's whole life.  The last two lines are the no-op controls and must
# SURVIVE.

store-public-channels-join	crates/mm-store/src/channel_store.rs	           JOIN publicchannels c ON c.id = ch.id\n          WHERE c.teamid = $1\n            AND (NOT $2	           JOIN channels c ON c.id = ch.id\n          WHERE c.teamid = $1\n            AND (NOT $2	api	parity::channel_search::
store-team-filter	crates/mm-store/src/channel_store.rs	          WHERE c.teamid = $1\n            AND (NOT $2	          WHERE (c.teamid = $1 OR TRUE)\n            AND (NOT $2	api	parity::channel_search::
store-search-presence-bit	crates/mm-store/src/channel_store.rs	            AND (NOT $2\n                 OR LOWER(c.name) LIKE LOWER($3) ESCAPE '*'	            AND ($2\n                 OR LOWER(c.name) LIKE LOWER($3) ESCAPE '*'	api	parity::channel_search::
store-displayname-arm	crates/mm-store/src/channel_store.rs	                 OR LOWER(c.displayname) LIKE LOWER($3) ESCAPE '*'\n                 OR LOWER(c.purpose) LIKE LOWER($3) ESCAPE '*'	                 OR LOWER(c.purpose) LIKE LOWER($3) ESCAPE '*'	api	parity::channel_search::
