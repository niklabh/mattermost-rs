# Mutation plan for GET /api/v4/posts/{post_id} — see CLAUDE.md § "Mutation testing".
#
#   MUTATE_API_SUITE=parity_post_get scripts/mutate-batch.sh scripts/mutations/post_get.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite.  `\n` becomes a newline.
#
# S2 was first written as `AND (false OR posts.deleteat = 0)`. That does not compile: sqlx's
# query_as! then sees `$2` unused and the bind-count no longer matches, so the mutation reports a
# non-zero exit with no failing test — a harness fault, not a caught mutation. A mutation must
# produce a *working* program that is wrong, never one that will not build.
# --- store: SqlPostStore.GetSingle -------------------------------------------------------
S1 deleted-post predicate inverted	crates/mm-store/src/post_store.rs	AND ($2 OR posts.deleteat = 0)	AND ($2 OR posts.deleteat != 0)	api
S2 include_deleted flag never reaches the store	crates/mm-app/src/post.rs	.get_single(post_id, incl_deleted)	.get_single(post_id, false)	api
S3 reply-count root case inverted	crates/mm-store/src/post_store.rs	CASE WHEN posts.rootid = '' THEN posts.id ELSE posts.rootid END	CASE WHEN posts.rootid != '' THEN posts.id ELSE posts.rootid END	api
S4 reply-count deleted filter dropped	crates/mm-store/src/post_store.rs	\n                       AND p.deleteat = 0) AS "reply_count!"	) AS "reply_count!"	api
S5 acknowledgement soft-delete filter inverted	crates/mm-store/src/post_store.rs	WHERE acknowledgedat != 0	WHERE acknowledgedat = 0	api
S6 priority booleans swapped	crates/mm-store/src/post_store.rs	requestedack            AS "requested_ack?",\n                   persistentnotifications AS "persistent_notifications?"	persistentnotifications AS "requested_ack?",\n                   requestedack            AS "persistent_notifications?"	api
# --- store: SqlReactionStore --------------------------------------------------------------
S7 reaction order reversed	crates/mm-store/src/reaction_store.rs	ORDER BY createat	ORDER BY createat DESC	api
S8 UpdateAt coalesce falls back to zero	crates/mm-store/src/reaction_store.rs	COALESCE(updateat, createat) AS "update_at!"	COALESCE(updateat, 0) AS "update_at!"	api
S9 DeleteAt coalesce dropped from the predicate	crates/mm-store/src/reaction_store.rs	AND COALESCE(deleteat, 0) = 0	AND deleteat = 0	api
# --- store: SqlEmojiStore -----------------------------------------------------------------
S10 soft-deleted emoji filter dropped	crates/mm-store/src/emoji_store.rs	WHERE deleteat = 0\n               AND name = ANY($1)	WHERE name = ANY($1)	api
# --- store: SqlFileInfoStore --------------------------------------------------------------
S11 file deleted filter inverted	crates/mm-store/src/file_info_store.rs	AND ($2 OR fileinfo.deleteat = 0)	AND ($2 OR fileinfo.deleteat != 0)	api
S12 file channel_id reads the post id	crates/mm-store/src/file_info_store.rs	COALESCE(fileinfo.channelid, '')       AS "channel_id!"	COALESCE(fileinfo.postid, '')       AS "channel_id!"	api
