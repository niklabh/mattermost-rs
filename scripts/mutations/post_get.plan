# --- api: the handler ---------------------------------------------------------------------
H1 etag comparison inverted	crates/mm-api/src/posts.rs	if if_none_match.as_deref() == Some(etag.as_str()) {	if if_none_match.as_deref() != Some(etag.as_str()) {	api
H2 manage_system gate inverted	crates/mm-api/src/posts.rs	if include_deleted\n        && !state	if !include_deleted\n        && !state	api
H3 post id validity check dropped	crates/mm-api/src/posts.rs	if !is_valid_id(post_id) {	if false && !is_valid_id(post_id) {	api
# --- no-op controls: a CAUGHT here means the harness is noisy and no verdict counts --------
C1 control rename a binding	crates/mm-app/src/post.rs	let names = get_emoji_names_for_post(post, reactions);\n        if names.is_empty() {\n            return Ok(Vec::new());\n        }\n\n        let custom: Vec<String> = names	let emoji_names = get_emoji_names_for_post(post, reactions);\n        if emoji_names.is_empty() {\n            return Ok(Vec::new());\n        }\n\n        let custom: Vec<String> = emoji_names	api
