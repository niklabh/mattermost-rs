# Mutation plan for the system-operations family: `GET /api/v4/analytics/old`, the cache and
# pool resets, the three log routes, `POST /restart`, the three enterprise-upgrade routes, the two
# Elasticsearch routes, and `POST /api/v4/integrity` on the socket.
#
#   scripts/mutate-batch.sh scripts/mutations/sysops.plan
#
# Every line is a decision `parity::sysops` has a row for: the default report name, the team
# form's literal -1, the archived team the suite plants for `team_count`, the two active-user
# windows (monthly is 4 on this stack, daily 0), the 30-row window and the DISTINCT of the daily
# reports, the no-store header, the order and status of the Elasticsearch body check and the
# username half of the re-enter check, the 500 of a bad log filter and the empty map for other
# nodes, the one-second sleep, the enterprise-build flag and the upgrader's zero, and the two
# clauses of the orphan statement the six orphaned sessions on this stack make visible. Two
# no-op controls close the plan.

analytics-default-name-is-standard	crates/mm-api/src/sysops.rs	name = "standard".to_owned();	name = "extra_counts".to_owned();	api	sysops
analytics-team-inactive-is-minus-one	crates/mm-app/src/analytics.rs	(users_count as f64, -1.0)	(users_count as f64, 0.0)	api	sysops
analytics-team-count-excludes-deleted	crates/mm-app/src/analytics.rs	include_deleted: Some(false),	include_deleted: Some(true),	api	sysops
analytics-monthly-window-is-a-month	crates/mm-app/src/analytics.rs	.analytics_active_count(MONTH_MILLISECONDS, &active_options)	.analytics_active_count(DAY_MILLISECONDS, &active_options)	api	sysops
post-counts-window-is-thirty	crates/mm-store/src/post_store.rs	                      FROM posts_by_team_day\n                     WHERE teamid = $1 AND day >= $2 AND day <= $3\n                     ORDER BY 1 DESC\n                     LIMIT 30	                      FROM posts_by_team_day\n                     WHERE teamid = $1 AND day >= $2 AND day <= $3\n                     ORDER BY 1 DESC\n                     LIMIT 3	api	sysops
user-counts-are-distinct-authors	crates/mm-store/src/post_store.rs	COUNT(DISTINCT p.userid)::float8 AS "value!"	COUNT(p.userid)::float8 AS "value!"	api	sysops
caches-answer-no-store	crates/mm-api/src/sysops.rs	.insert("cache-control", HeaderValue::from_static(NO_STORE));	.insert("cache-control", HeaderValue::from_static("no-cache"));	api	sysops
