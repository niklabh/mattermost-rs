CONTROL-rename-file-binding	crates/mm-plugin/src/rpc/file_upload.rs	        let uploaded_file_stream = self.broker.next_id();\n        let broker = self.broker.clone();	        let uploaded_file_stream = self.broker.next_id();\n        let lender = self.broker.clone();\n        let broker = lender;	pkg	rpc_
