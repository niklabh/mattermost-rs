# Mutation plan for the websocket hub — Phase 0 of the write-route work.
#
#   scripts/mutate-batch.sh scripts/mutations/websocket-hub.plan
#
# What is worth mutating here is almost entirely `addressing_verdict`: five addressing fields
# whose **order** is the behaviour, two "contains data" flags whose polarity decides admin vs
# everyone, and a presence rule with two ANDed arms that a reader would naturally write as OR.
# Nothing about the hub's storage is interesting — a HashMap either holds the connection or it
# does not — so the plan does not spend lines there.
#
# The last two lines are the no-op controls and must SURVIVE.
hub-user-id-checked-before-connection-id	crates/mm-app/src/hub.rs	    if !broadcast.connection_id.is_empty() {\n        return verdict(conn.connection_id == broadcast.connection_id);\n    }\n\n    if conn.connection_id == broadcast.omit_connection_id {\n        return Verdict::Skip;\n    }\n\n    if !broadcast.user_id.is_empty() {\n        return verdict(conn.user_id == broadcast.user_id);\n    }	    if !broadcast.user_id.is_empty() {\n        return verdict(conn.user_id == broadcast.user_id);\n    }\n\n    if !broadcast.connection_id.is_empty() {\n        return verdict(conn.connection_id == broadcast.connection_id);\n    }\n\n    if conn.connection_id == broadcast.omit_connection_id {\n        return Verdict::Skip;\n    }	unit	hub::
