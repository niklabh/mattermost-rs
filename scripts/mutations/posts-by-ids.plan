# --- no-op controls: these must SURVIVE ---
control-rename-binding	crates/mm-api/src/posts.rs	Err(err) => {\n            tracing::warn!(error = %err, "could not read the request body");\n            return posts_by_ids_parse_error().into_response();	Err(cause) => {\n            tracing::warn!(error = %cause, "could not read the request body");\n            return posts_by_ids_parse_error().into_response();	api	posts_by_ids
