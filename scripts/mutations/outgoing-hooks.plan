# Mutation plan for GET /api/v4/hooks/outgoing (getOutgoingHooks).
#
#   scripts/mutate-batch.sh scripts/mutations/outgoing-hooks.plan
#
# What is worth mutating here and is *not* worth re-mutating from the incoming plan: the three
# permission **scopes** and the order the branches are tried in (`channel_id` wins over `team_id`);
# the owner column, which is `CreatorId` here and `UserId` on the incoming table; and the three
# states of a `model.StringArray` column — NULL, `[]`, populated — which a store defaulting a NULL
# to `[]` would collapse into two.
#
# **Two lines run under `store`, not `api`.** The owner filter is unreachable over HTTP: the only
# roles granting `manage_own_*_webhooks` also grant `manage_others_*`, so every caller that can
# reach either route arrives with the filter already cleared. `store-outgoing-creator-column`
# survived the whole `api` suite for that reason. `tests/db_webhook_owner_filter.rs` exercises the
# branch where it is reachable — at the store, with the owner passed directly — and both tables'
# columns are mutated there, because `IncomingWebhooks.UserId` and `OutgoingWebhooks.CreatorId`
# are different columns doing the same job.
#
# The last two lines are the no-op controls and must SURVIVE.

store-outgoing-null-array-becomes-empty	crates/mm-store/src/webhook_store.rs	        None => Ok(None),	        None => Ok(Some(Vec::new())),	api	outgoing_hooks
store-outgoing-channel-predicate	crates/mm-store/src/webhook_store.rs	             WHERE channelid = $1\n               AND deleteat = 0	             WHERE ($1 = $1)\n               AND deleteat = 0	api	outgoing_hooks
store-outgoing-team-predicate	crates/mm-store/src/webhook_store.rs	             WHERE teamid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR creatorid = $2)	             WHERE ($1 = $1)\n               AND deleteat = 0\n               AND ($2 = '' OR creatorid = $2)	api	outgoing_hooks
store-outgoing-creator-column	crates/mm-store/src/webhook_store.rs	             WHERE channelid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR creatorid = $2)	             WHERE channelid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR channelid = $2)	store	a_named_owner
store-incoming-owner-column	crates/mm-store/src/webhook_store.rs	             WHERE teamid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR userid = $2)	             WHERE teamid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR teamid = $2)	store	a_named_owner
