# --- no-op controls: these must SURVIVE ---
control-rename-binding	crates/mm-api/src/webhooks.rs	    tracing::Span::current().record("count", hooks.len());	    tracing::Span::current().record("count", { let listed = &hooks; listed.len() });	api	incoming_hooks
control-reorder-independent-selects	crates/mm-store/src/webhook_store.rs	                   COALESCE(username, '')      AS "username!",\n                   COALESCE(iconurl, '')       AS "iconurl!",\n                   COALESCE(channellocked, FALSE) AS "channellocked!",\n                   lastused                    AS "lastused!"\n              FROM incomingwebhooks\n             WHERE teamid = $1	                   COALESCE(iconurl, '')       AS "iconurl!",\n                   COALESCE(username, '')      AS "username!",\n                   COALESCE(channellocked, FALSE) AS "channellocked!",\n                   lastused                    AS "lastused!"\n              FROM incomingwebhooks\n             WHERE teamid = $1	api	incoming_hooks
