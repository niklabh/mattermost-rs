# Mutation plan for GET /api/v4/hooks/incoming (getIncomingHooks).
#
#   scripts/mutate-batch.sh scripts/mutations/incoming-hooks.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
#
# The decisions worth mutating: the `DisplayName, Id` sort (the fixture plants two hooks sharing a
# display name, inserted in reverse id order, so dropping the tiebreak falls back to the heap);
# which of the two permission **scopes** each branch asks for (the fixture's team admin is the only
# caller that answers differently to the two, and getting it wrong fails *open*); whether
# `manage_others_incoming_webhooks` clears the user filter; and that `include_total_count` takes the
# same cleared filter the page did, so the count cannot disagree with the array beside it.
#
# **One mutation was replaced rather than carried as a survivor.** Widening the team branch's
# predicate to `($1 = '' OR teamid = $1)` is a *no-op*, not a mutation: that branch is entered only
# when `team_id` is non-empty, so the added disjunct is always false. It now drops the predicate
# outright, which the other team's planted hook can see.
#
# The last two lines are the no-op controls and must SURVIVE.

store-team-order-tiebreak	crates/mm-store/src/webhook_store.rs	             WHERE teamid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR userid = $2)\n             ORDER BY displayname, id	             WHERE teamid = $1\n               AND deleteat = 0\n               AND ($2 = '' OR userid = $2)\n             ORDER BY displayname	api	incoming_hooks
store-list-order-tiebreak	crates/mm-store/src/webhook_store.rs	             WHERE deleteat = 0\n               AND ($1 = '' OR userid = $1)\n             ORDER BY displayname, id	             WHERE deleteat = 0\n               AND ($1 = '' OR userid = $1)\n             ORDER BY displayname	api	incoming_hooks
store-team-deleteat	crates/mm-store/src/webhook_store.rs	             WHERE teamid = $1\n               AND deleteat = 0	             WHERE teamid = $1\n               AND deleteat >= 0	api	incoming_hooks
store-team-user-filter	crates/mm-store/src/webhook_store.rs	               AND ($2 = '' OR userid = $2)\n             ORDER BY displayname, id	               AND userid = $2\n             ORDER BY displayname, id	api	incoming_hooks
store-team-predicate-dropped	crates/mm-store/src/webhook_store.rs	             WHERE teamid = $1\n               AND deleteat = 0	             WHERE ($1 = $1)\n               AND deleteat = 0	api	incoming_hooks
store-count-team-filter	crates/mm-store/src/webhook_store.rs	             WHERE deleteat = 0\n               AND ($1 = '' OR teamid = $1)	             WHERE deleteat = 0\n               AND ($1 = '' OR teamid <> '')	api	incoming_hooks
store-count-deleteat	crates/mm-store/src/webhook_store.rs	             WHERE deleteat = 0\n               AND ($1 = '' OR teamid = $1)	             WHERE deleteat >= 0\n               AND ($1 = '' OR teamid = $1)	api	incoming_hooks
