# Mutation plan for the two `api4/report.go` reads — `GET /api/v4/reports/users` and
# `GET /api/v4/reports/users/count`.
#
#   scripts/mutate-batch.sh scripts/mutations/user-reports.plan
#
# Four layers, and the interesting one is the store.
#
# The report query folds nine `squirrel` fragments, a keyset cursor whose *column* is a parameter,
# and a reversing outer wrapper into one statement. Almost every mutation below is a predicate a
# reader could plausibly write the other way round: `= 1` against `> 1` for the guest filter,
# `>=` against `>` on the date window, `<` against `>` on the cursor, and the `Users.Id`
# tiebreaker that stays **ASC** even on a descending page.
#
# The date-window block is the reason the fixture plants posts on four separate days — today, the
# first of this month, the first of last month, and a hundred days back. Posting only through the
# API puts every row on today's date, and then `ps.Day >= start` / `ps.Day < end` are unreachable:
# four of the mutations here survive against such a fixture and catch nothing.
#
# `report-search-is-prefix-only` and `report-search-drops-the-id-arm` are likewise only catchable
# because the suite searches for a *middle* substring and for a bare user id; a suite that only
# searched for the username prefix would report both as CAUGHT-by-nothing.

report-guest-single-counts-many	crates/mm-store/src/user_store.rs	($9 = 1 AND cc.n = 1)	($9 = 1 AND cc.n > 1)	api	user_reports
report-guest-multi-includes-one	crates/mm-store/src/user_store.rs	($9 = 2 AND cc.n > 1)	($9 = 2 AND cc.n >= 1)	api	user_reports
count-guest-single-counts-many	crates/mm-store/src/user_store.rs	($6 = 1 AND cc.n = 1)	($6 = 1 AND cc.n > 1)	api	user_reports
report-hide-active-keeps-the-active	crates/mm-store/src/user_store.rs	AND (NOT $6 OR u.deleteat > 0)	AND (NOT $6 OR u.deleteat = 0)	api	user_reports
report-hide-inactive-inverted	crates/mm-store/src/user_store.rs	AND (NOT $7 OR u.deleteat = 0)	AND (NOT $7 OR u.deleteat > 0)	api	user_reports
count-hide-active-keeps-the-active	crates/mm-store/src/user_store.rs	AND (NOT $3 OR u.deleteat > 0)	AND (NOT $3 OR u.deleteat = 0)	api	user_reports
report-has-no-team-counts-left-teams	crates/mm-store/src/user_store.rs	AND (NOT $5 OR u.id NOT IN (SELECT userid FROM teammembers WHERE deleteat = 0))	AND (NOT $5 OR u.id NOT IN (SELECT userid FROM teammembers))	api	user_reports
report-teams-aggregate-keeps-left-teams	crates/mm-store/src/user_store.rs	WHERE tmt.userid = u.id AND tmt.deleteat = 0), '') AS teams,	WHERE tmt.userid = u.id), '') AS teams,	api	user_reports
report-channel-count-includes-dms	crates/mm-store/src/user_store.rs	                      INNER JOIN channels c\n                        ON c.id = cm.channelid AND c.deleteat = 0 AND c.type IN ('O', 'P')	                      INNER JOIN channels c\n                        ON c.id = cm.channelid AND c.deleteat = 0 AND c.type IN ('O', 'P', 'D')	api	user_reports
report-team-join-ignores-membership-deleteat	crates/mm-store/src/user_store.rs	ON (tm.userid = u.id AND tm.deleteat = 0 AND tm.teamid = $4)	ON (tm.userid = u.id AND tm.teamid = $4)	api	user_reports
