# Mutation plan for the per-thread read-state pair and typing:
#
#   PUT  /users/{user_id}/teams/{team_id}/threads/{thread_id}/read/{timestamp}
#   POST /users/{user_id}/teams/{team_id}/threads/{thread_id}/set_unread/{post_id}
#   POST /users/{user_id}/typing
#
#   scripts/mutate-batch.sh scripts/mutations/thread-read.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
#
# The parity suite runs each write on ONE thread against both servers with the same planted row,
# so the bodies are byte-compared and the counts have to be Go's number exactly. The store
# boundaries (`>` vs `>=`, `DeleteAt = 0`) are additionally pinned by
# `mm-store/tests/db_thread_read_state.rs`, on rows planted AT the boundary.
#
# `thread_store.rs` holds three statements that write `LastViewed`; every anchor here carries a
# token unique to its statement (`lastupdated = $2\n             WHERE userid = $3` is
# mark_as_read's, `unreadmentions = $6` is update_membership's).
#
# The mention-parser lines run the unit suite: the parser is pure and its branches are pinned by
# `mention::tests`; the parity suite would catch most of them too, at ten times the cost.
#
# Three lines keep a bind parameter referenced with a no-op (`$1::bigint >= 0`, `+ ($6 - $6)`,
# `TRUE OR $3`): a dropped bind is a sqlx compile error and a HARNESS FAULT, not a verdict, and
# the cast is needed too — an untyped `$1 >= 0` infers int4 against an i64 bind. The first run
# of this plan showed both.
#
# `addMention`'s `>=` has no mutation here on purpose: `>` is an *equivalent* mutant, since the
# only case it changes — an equal priority — rewrites the map entry with the value it already
# holds. It survived the first run for that reason, not for a missing test.
#
# The last two lines are the no-op controls and must SURVIVE.

read-mark-is-the-clock	crates/mm-store/src/thread_store.rs	               SET lastviewed = $1,\n                   lastupdated = $2\n             WHERE userid = $3	               SET lastviewed = $2,\n                   lastupdated = $2\n             WHERE userid = $3 AND $1::bigint >= 0	api	thread_read
unread-count-inclusive	crates/mm-store/src/thread_store.rs	               AND posts.createat > $2	               AND posts.createat >= $2	api	thread_read
unread-count-keeps-deleted	crates/mm-store/src/thread_store.rs	               AND posts.createat > $2\n               AND posts.deleteat = 0	               AND posts.createat > $2\n               AND posts.deleteat >= 0	api	thread_read
membership-mentions-not-written	crates/mm-store/src/thread_store.rs	                   unreadmentions = $6	                   unreadmentions = unreadmentions + ($6::bigint - $6::bigint)	api	thread_read
membership-following-forced	crates/mm-store/src/thread_store.rs	               SET following = $3,	               SET following = TRUE OR $3::boolean,	api	thread_read
thread-posts-exclusive	crates/mm-store/src/post_store.rs	               AND posts.createat >= $2	               AND posts.createat > $2	api	thread_read
