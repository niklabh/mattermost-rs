# Equivalent: must SURVIVE. hashicorp/yamux's SynSent and Established states behave identically
# once the SYN is out (same flags from sendFlags, same Close and FIN transitions), so an ACK that
# fails to promote the state is unobservable.
EQUIVALENT-ack-leaves-stream-unestablished	crates/goplugin/src/yamux.rs	            if st.state == State::SynSent {	            if st.state == State::Init {	pkg

CONTROL-reorder-header-bytes	crates/goplugin/src/yamux.rs	    h[0] = PROTO_VERSION;\n    h[1] = ty;	    h[1] = ty;\n    h[0] = PROTO_VERSION;	pkg
CONTROL-header-size-expression	crates/goplugin/src/yamux.rs	const HEADER_SIZE: usize = 12;	const HEADER_SIZE: usize = 4 * 3;	pkg
