# Mutation plan for goplugin's yamux (plugin plan Phase 2).
#
#   MUTATE_PACKAGE=goplugin scripts/mutate-batch.sh scripts/mutations/goplugin-yamux.plan
#
# The decisions hashicorp/yamux makes that go-plugin depends on: the eager SYN, the SYN backlog,
# frame sizes up to the window, credit returned at half a window, half-close in both orders, the
# backlog reset, GoAway, pings, the open and close timeouts, and draining queued frames on close.
# The CONTROL- lines must SURVIVE.

window-update-sent-too-eagerly	crates/goplugin/src/yamux.rs	        if delta < max / 2 && flags == 0 {	        if delta < max / 4 && flags == 0 {	pkg
open-ignores-the-syn-backlog	crates/goplugin/src/yamux.rs	            p = inner.syn.clone().acquire_owned() => p.map_err(|_| Error::SessionShutdown)?,	            p = inner.syn.clone().acquire_many_owned(0) => p.map_err(|_| Error::SessionShutdown)?,	pkg
first-frame-carries-no-syn	crates/goplugin/src/yamux.rs	            State::Init => {\n                self.state = State::SynSent;\n                FLAG_SYN	            State::Init => {\n                self.state = State::SynSent;\n                0	pkg
