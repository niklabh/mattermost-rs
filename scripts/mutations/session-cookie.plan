# Mutation plan for [D-169]: RemoveSessionCookie, the subpath it scopes the cookie to, and
# SiteURL becoming a modelled setting.
#
#   scripts/mutate-batch.sh scripts/mutations/session-cookie.plan
#
# The decisions a reader could plausibly get wrong:
#
#   * The cookie is cleared when a token was **present and rejected** — not on every 401, and not
#     on a 500. Go's branch is `else if h.RequireSession` under `if token != ""`, and a database
#     failure must not log anybody out.
#   * `MaxAge: -1` renders as `Max-Age=0`, and an empty Path is **omitted** rather than sent as
#     `Path=`.
#   * `GetSubpathFromConfig` reaches "/" from three different places (no SiteURL, an empty parsed
#     path, a path that cleans away) and "" from a fourth (a parse failure). Collapsing any two is
#     right today and wrong the moment one moves.
#   * `path.Clean` runs on the **decoded** path, so `%2F` becomes a real separator.
#   * `SiteURL`'s presence is `isUpdate`; its value is the subpath. An `Option<String>` flattened
#     to `String` makes every document look like a fresh install.
#
# The last two lines are the no-op controls and must SURVIVE.

# --- the subpath ---
subpath-parse-failure-becomes-root	crates/mm-app/src/config.rs	        let Ok(url) = mm_model::go_url::go_parse(site_url) else {\n            // Go: `return "", errors.Wrap(err, ...)`, and the caller drops the error.\n            return String::new();	        let Ok(url) = mm_model::go_url::go_parse(site_url) else {\n            // Go: `return "", errors.Wrap(err, ...)`, and the caller drops the error.\n            return "/".to_owned();	unit	config::
subpath-absent-site-url-becomes-empty	crates/mm-app/src/config.rs	        let Some(site_url) = self.site_url.as_deref() else {\n            return "/".to_owned();	        let Some(site_url) = self.site_url.as_deref() else {\n            return String::new();	unit	config::
subpath-empty-path-is-not-special-cased	crates/mm-app/src/config.rs	        if url.path.is_empty() {\n            return "/".to_owned();\n        }	        if false {\n            return "/".to_owned();\n        }	unit	config::
subpath-skips-the-clean	crates/mm-app/src/config.rs	        mm_model::go_path::clean(&String::from_utf8_lossy(&url.path))	        String::from_utf8_lossy(&url.path).into_owned()	unit	config::
subpath-cleans-the-raw-path	crates/mm-app/src/config.rs	        mm_model::go_path::clean(&String::from_utf8_lossy(&url.path))	        mm_model::go_path::clean(&String::from_utf8_lossy(&url.raw_path))	unit	config::

