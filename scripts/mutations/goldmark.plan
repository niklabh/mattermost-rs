# gogoldmark mutations: MUTATE_PACKAGE=gogoldmark MMRS_STACK_LOCKED=1 scripts/mutate-batch.sh scripts/mutations/goldmark.plan
# (suite pkg touches no stack, so the stack lock is not needed).
# Control no-ops first: if either fails, the harness is noisy and nothing below means anything.
control-type-annotation	crates/gogoldmark/src/parser/inline.rs	    let mut run = 0;	    let mut run: usize = 0;	pkg
control-field-order	crates/gogoldmark/src/parser/mod.rs	            block_offset: -1,\n            block_indent: -1,	            block_indent: -1,\n            block_offset: -1,	pkg
# Delimiter runs: flanking, the underscore rules, the rule of three, consumption.
flank-left-before-punct	crates/gogoldmark/src/parser/inline.rs	(!after_is_punctuation || before_is_whitespace || before_is_punctuation)	(!after_is_punctuation || before_is_whitespace)	pkg
flank-right-after-punct	crates/gogoldmark/src/parser/inline.rs	(!before_is_punctuation || after_is_whitespace || after_is_punctuation)	(!before_is_punctuation || after_is_whitespace)	pkg
underscore-open	crates/gogoldmark/src/parser/inline.rs	is_left && (!is_right || before_is_punctuation),	is_left && !is_right,	pkg
underscore-close	crates/gogoldmark/src/parser/inline.rs	is_right && (!is_left || after_is_punctuation),	is_right,	pkg
rule-of-three-closer-mod	crates/gogoldmark/src/parser/inline.rs	        && closer.original_length % 3 != 0\n	\n	pkg
consume-two-needs-both	crates/gogoldmark/src/parser/inline.rs	if d.length >= 2 && closer.length >= 2 {	if d.length >= 2 || closer.length >= 2 {	pkg
strike-after-tilde	crates/gogoldmark/src/parser/inline.rs	(d.original_length > 2 || before == '~')	(d.original_length > 2)	pkg
