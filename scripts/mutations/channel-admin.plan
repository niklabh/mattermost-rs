# Mutation plan for the four channel-administration routes.
#
#   scripts/mutate-batch.sh scripts/mutations/channel-admin.plan
#
# Three of the four routes are a gate and nothing else on an unlicensed server, so their
# mutations are about *which* error at *which* status and *in what order* — the scheme route's
# 400-before-403 is the only ordering here that a client can see.
#
# The fourth, `members_minus_group_members`, is real SQL, and the decisions worth mutating are
# the ones a reader would drop as redundant:
#
#   * `Bots.UserId IS NULL`, which is the only reason the LEFT JOIN to `Bots` exists;
#   * the three `DeleteAt = 0` predicates, one per table, each meaning something different;
#   * `count(DISTINCT Users.Id)` against the page query's `GROUP BY`, which disagree only for a
#     user in more than one group;
#   * `LIMIT`/`OFFSET`, which agree on page 0 and nowhere else;
#   * the `group_ids` length gate running on the **stripped** string and the split on the raw one.
#
# The last two lines are the no-op controls and must SURVIVE.
page-keeps-bots	crates/mm-store/src/group_store.rs	             WHERE c.deleteat = 0\n               AND u.deleteat = 0\n               AND b.userid IS NULL\n               AND c.id = $1\n               AND u.id NOT IN (\n                     SELECT igm.userid\n                       FROM groupmembers igm\n                       JOIN usergroups iug ON iug.id = igm.groupid\n                      WHERE igm.deleteat = 0\n                        AND igm.groupid = ANY($2)\n                   )\n             GROUP BY u.id, cm.schemeguest, cm.schemeadmin, cm.schemeuser\n	             WHERE c.deleteat = 0\n               AND u.deleteat = 0\n               AND (b.userid IS NULL OR TRUE)\n               AND c.id = $1\n               AND u.id NOT IN (\n                     SELECT igm.userid\n                       FROM groupmembers igm\n                       JOIN usergroups iug ON iug.id = igm.groupid\n                      WHERE igm.deleteat = 0\n                        AND igm.groupid = ANY($2)\n                   )\n             GROUP BY u.id, cm.schemeguest, cm.schemeadmin, cm.schemeuser\n	api	channel_admin
