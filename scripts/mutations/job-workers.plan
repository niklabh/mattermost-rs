# Mutation plan for the job workers — the JobServer transitions, SimpleWorker.DoJob, the
# watcher and the schedulers.
#
#   MUTATE_STORE_TARGETS="--test db_job_store_runtime" scripts/mutate-batch.sh scripts/mutations/job-workers.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
# No `api` lines: not one of these functions is reachable from a route, which is the whole
# reason the tests are `store` and `app` suites rather than parity ones.
# The last two lines are the no-op controls and must SURVIVE.

watcher-reads-newest-first	crates/mm-store/src/job_store.rs	             WHERE status = $1\n             ORDER BY createat ASC	             WHERE status = $1\n             ORDER BY createat DESC	store	job_runtime_
pending-count-ignores-the-type	crates/mm-store/src/job_store.rs	FROM jobs WHERE status = $1 AND type = $2"#,	FROM jobs WHERE status = $1 AND ($2::text IS NOT NULL)"#,	store	job_runtime_
pending-count-ignores-the-status	crates/mm-store/src/job_store.rs	FROM jobs WHERE status = $1 AND type = $2"#,	FROM jobs WHERE ($1::text IS NOT NULL) AND type = $2"#,	store	job_runtime_
