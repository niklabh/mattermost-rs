optimistic-update-drops-the-guard	crates/mm-store/src/job_store.rs	                   progress = $6\n             WHERE id = $1 AND status = $2	                   progress = $6\n             WHERE id = $1 AND ($2::text IS NOT NULL)	store	job_runtime_
