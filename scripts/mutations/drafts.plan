# Mutation plan for GET /users/{user_id}/teams/{team_id}/drafts (getDrafts).
#
#   scripts/mutate-batch.sh scripts/mutations/drafts.plan
#
# Tab-separated: name<TAB>file<TAB>from<TAB>to<TAB>suite<TAB>filter.  `\n` becomes a newline.
#
# The store's query is one of a kind in this tree, so its anchors need no disambiguation.  The
# fixture was built for the three predicates that would otherwise be dead: a draft in a channel
# the author has left (the `ChannelMembers` join), a draft in a DM (`TeamId = ''`), and one
# carrying non-empty `Props` and `Priority` (the two `varchar`-holding-JSON decoders, which an
# all-`{}` fixture cannot distinguish from a decoder that returns the empty map for everything).
#
# `store-channel-members-join` was first written as INNER -> LEFT JOIN, which is **inert**: the
# `cm.userid = $1` in the WHERE clause discards the NULL-extended rows a left join would add.
# It now breaks the join *column* instead, which is the decision a reader could actually get
# wrong. And `control-rename-binding` first renamed a binding used again three lines below its
# anchor, which is a compile error and voids the whole run rather than surviving it.
#
# The last two lines are the no-op controls and must SURVIVE.

store-channel-members-join	crates/mm-store/src/draft_store.rs	              INNER JOIN channelmembers cm ON cm.channelid = d.channelid	              INNER JOIN channelmembers cm ON cm.userid = d.userid	api	parity::drafts
store-membership-subject	crates/mm-store/src/draft_store.rs	               AND cm.userid = $1\n	               AND cm.userid IS NOT NULL\n	api	parity::drafts
store-draft-owner	crates/mm-store/src/draft_store.rs	               AND d.userid = $1\n	               AND d.userid IS NOT NULL\n	api	parity::drafts
store-teamless-channels	crates/mm-store/src/draft_store.rs	               AND (c.teamid = $2 OR c.teamid = '')	               AND (c.teamid = $2)	api	parity::drafts
store-team-filter	crates/mm-store/src/draft_store.rs	               AND (c.teamid = $2 OR c.teamid = '')	               AND (c.teamid <> $2 OR c.teamid = '')	api	parity::drafts
store-order-direction	crates/mm-store/src/draft_store.rs	             ORDER BY d.updateat DESC	             ORDER BY d.updateat ASC	api	parity::drafts
store-props-column	crates/mm-store/src/draft_store.rs	                   d.props               AS "props?",\n                   d.priority            AS "priority?",	                   d.priority            AS "props?",\n                   d.props               AS "priority?",	api	parity::drafts
