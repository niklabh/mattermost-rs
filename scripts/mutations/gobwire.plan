# Equivalent mutants: must SURVIVE. Typed and dynamic decoding only run on a value the skip-scan
# in Decoder::push_message has already accepted, and that scan carries the same count guard
# (guard-skip-map-count), so these two guards are unreachable through the public API. They stay
# in the code as defence in depth; a CAUGHT here means the scan and the decode have diverged.
EQUIVALENT-guard-dynamic-map-count	crates/gobwire/src/decode.rs	                    self.expect_element(n)?;\n                    let k = self.read_dynamic(kt, key_id)?;	                    let k = self.read_dynamic(kt, key_id)?;	pkg
EQUIVALENT-guard-typed-map-count	crates/gobwire/src/impls.rs	                    d.expect_element(n)?;\n                    let mut k = K::default();	                    let mut k = K::default();	pkg

