notices-client-version-always-parsed	crates/mm-app/src/product_notices.rs	let client_version = new_version(inputs.client_version)\n            .ok_or_else(|| format!("Cannot parse version range {}", inputs.client_version))?;	let client_version = new_version(inputs.client_version).or_else(|| new_version("0.0.0")).ok_or_else(|| String::new())?;	api	sysops::the_product_notices
