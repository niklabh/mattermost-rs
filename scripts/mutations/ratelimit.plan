# Mutation plan for D-430: the rate limiter (throttled's GCRA and memstore, app.RateLimiter, and
# its three placements — the route limiters, the global one, the per-user one).
#
#   MUTATE_PACKAGE=mm-api scripts/mutate-batch.sh scripts/mutations/ratelimit.plan
#
# Not planned, because they are equivalent: `now > tat` as `>=` (equal gives the same new TAT);
# the `next > -emission` guard as `next > 0` (a next in between truncates to 0 either way); the
# per-user query-token refusal (no route this server answers is reached with a non-OAuth query
# token and a live session in any parity test — it would need `?access_token=` on a burst); the
# global refusal with or without `WebOwnHeaders` (the global layer is outside `go_global_headers`,
# so nothing reads the marker — measured: it survived the first run).

# ---- the GCRA and the store (go_parity)
rl-limit-no-plus-one	crates/mm-api/src/ratelimit.rs	limit: max_burst.saturating_add(1),	limit: max_burst,	lib	ratelimit::
rl-dvt-no-plus-one	crates/mm-api/src/ratelimit.rs	period.saturating_mul(max_burst.saturating_add(1))	period.saturating_mul(max_burst)	lib	ratelimit::
rl-retry-sign	crates/mm-api/src/ratelimit.rs	result.retry_after = -diff;	result.retry_after = diff.abs() + 1;	lib	ratelimit::
rl-limited-ttl-new	crates/mm-api/src/ratelimit.rs	                tat - now\n	                new_tat - now\n	lib	ratelimit::
rl-remaining-ceil	crates/mm-api/src/ratelimit.rs	result.remaining = next / self.emission_interval;	result.remaining = (next + self.emission_interval - 1) / self.emission_interval;	lib	ratelimit::
rl-limited-still-stores	crates/mm-api/src/ratelimit.rs	            limited = true;	            limited = true;\n            store.set(key, new_tat);	lib	ratelimit::
lru-read-no-refresh	crates/mm-api/src/ratelimit.rs	    fn get(&mut self, key: &str) -> Option<i64> {\n        self.touch(key);	    fn get(&mut self, key: &str) -> Option<i64> {	lib	ratelimit::
lru-evicts-newest	crates/mm-api/src/ratelimit.rs	self.order.pop_first()	self.order.pop_last()	lib	ratelimit::
lru-off-by-one	crates/mm-api/src/ratelimit.rs	if self.entries.len() > self.max_keys	if self.entries.len() >= self.max_keys	lib	ratelimit::

# ---- headers and keys (go_parity)
