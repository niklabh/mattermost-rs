# GET /users/stats for a view-restricted caller: applyViewRestrictionsFilter in SqlUserStore.Count (2026-09-28).
#   scripts/mutate-batch.sh scripts/mutations/view-restricted-count.plan
count-distinct	crates/mm-store/src/user_store.rs	SELECT COUNT(*) AS "count!"\n              FROM users u\n              LEFT JOIN bots b ON b.userid = u.id\n              LEFT JOIN teammembers tm	SELECT COUNT(DISTINCT u.id) AS "count!"\n              FROM users u\n              LEFT JOIN bots b ON b.userid = u.id\n              LEFT JOIN teammembers tm	api	a_restricted_callers_user_count_is_gos
nobody-guard-dropped	crates/mm-store/src/user_store.rs	               AND NOT $7\n	               AND ($7 OR NOT $7)\n	api	a_restricted_callers_user_count_is_gos
departed-team-counted	crates/mm-store/src/user_store.rs	                       AND rtm.deleteat = 0\n	                       AND rtm.deleteat >= 0\n	api	a_restricted_callers_user_count_is_gos
teams-bound-to-channels	crates/mm-store/src/user_store.rs	                       AND rtm.teamid = ANY($8::text[])	                       AND rtm.teamid = ANY($9::text[]) AND cardinality($8::text[]) >= 0	api	a_restricted_callers_user_count_is_gos
empty-channels-arm-empty	crates/mm-store/src/user_store.rs	                    SELECT 1 WHERE cardinality($9::text[]) = 0	                    SELECT 1 WHERE cardinality($9::text[]) < 0	api	a_restricted_callers_user_count_is_gos
nobody-is-either-empty	crates/mm-store/src/user_store.rs	                    r.teams.is_empty() && r.channels.is_empty(),	                    r.teams.is_empty() || r.channels.is_empty(),	api	a_restricted_callers_user_count_is_gos
handler-drops-restrictions	crates/mm-api/src/users.rs	        .get_total_users_stats(restrictions.as_ref())	        .get_total_users_stats(restrictions.as_ref().filter(|_| false))	api	a_restricted_callers_user_count_is_gos
CONTROL-alias-rename	crates/mm-store/src/user_store.rs	                   ) AS rt\n	                   ) AS rtx\n	api	a_restricted_callers_user_count_is_gos
CONTROL-where-reorder	crates/mm-store/src/user_store.rs	             WHERE ($1 OR u.deleteat = 0)\n               AND ($2 OR u.remoteid = '' OR u.remoteid IS NULL)\n               AND ($3 OR b.userid IS NULL)\n               AND (NOT $6	             WHERE ($2 OR u.remoteid = '' OR u.remoteid IS NULL)\n               AND ($1 OR u.deleteat = 0)\n               AND ($3 OR b.userid IS NULL)\n               AND (NOT $6	api	a_restricted_callers_user_count_is_gos
