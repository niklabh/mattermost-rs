# Mutation plan for GET /api/v4/channels/{channel_id}/common_teams
# (getDirectOrGroupMessageMembersCommonTeams).
#
#   scripts/mutate-batch.sh scripts/mutations/common-teams.plan
#
# The decisions here: `HAVING COUNT = len(userIDs)` is what makes the answer an *intersection*
# rather than a union; the two `DeleteAt = 0`s (a membership someone left, and a deleted team) do
# different jobs and `GetMany` beside them has neither; the guest gate runs **before** the
# permission check, so which of two 403s a guest gets depends on the order; and the three empty
# answers — `[]`, `null`, and a forward — are three different bytes.
#
# **Three lines run under `store`.** `GetMany` has no `DeleteAt` predicate and turns an empty
# result into a typed not-found, and neither is reachable over HTTP: its only migrated caller
# feeds it ids that a query has already filtered archived teams out of, and never an empty list.
# `tests/db_team_get_many.rs` exercises both directly. The filter is a **test name**, not a file
# name — see `scripts/mutate.sh`.
#
# `store-common-having-count` mutates the **bound value** rather than the `HAVING` expression:
# rewriting the SQL to force a union changes the type sqlx infers for the column and the mutated
# source stops compiling, which is a harness fault and not a verdict. Passing `1` instead of the
# id count is the same semantic change — "any member" instead of "every member" — with the query
# untouched.
#
# The last two lines are the no-op controls and must SURVIVE.

store-common-having-count	crates/mm-store/src/team_store.rs	        i64::try_from(user_ids.len()).unwrap_or(i64::MAX)	        1i64	api	common_teams
store-common-membership-deleteat	crates/mm-store/src/team_store.rs	                 WHERE userid = ANY($1)\n                   AND deleteat = 0	                 WHERE userid = ANY($1)\n                   AND deleteat >= 0	api	common_teams
store-common-team-deleteat	crates/mm-store/src/team_store.rs	         WHERE t.deleteat = 0\n         GROUP BY t.id	         WHERE t.deleteat >= 0\n         GROUP BY t.id	api	common_teams
store-get-many-empty-is-not-found	crates/mm-store/src/team_store.rs	        return Err(StoreError::NotFound {\n            entity: "Team",\n            criteria: format!("ids={ids:?}"),\n        });	        return Ok(Vec::new());	store	get_many_returns_archived
store-get-many-deleteat-filter	crates/mm-store/src/team_store.rs	          FROM teams t\n         WHERE t.id = ANY($1)\n        "#,\n        ids	          FROM teams t\n         WHERE t.id = ANY($1) AND t.deleteat = 0\n        "#,\n        ids	store	get_many_returns_archived
store-get-many-id-filter	crates/mm-store/src/team_store.rs	          FROM teams t\n         WHERE t.id = ANY($1)\n        "#,\n        ids	          FROM teams t\n         WHERE t.id = ANY($1) OR TRUE\n        "#,\n        ids	store	get_many_returns_archived
