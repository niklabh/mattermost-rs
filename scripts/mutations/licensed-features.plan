# Mutation plan for the 2026-09-07 licence-gated families — seventeen routes.
#
#   scripts/mutate-batch.sh scripts/mutations/licensed-features.plan
#
# The whole content of these routes is one refusal taken before every other check, so the risk is
# concentrated in three places: the direction of the licence test, the status, and **which of the
# two error ids** each route names. The two families sit in one module precisely so that the second
# risk is visible, and half these mutations swap one id for the other.
#
# The last two lines are the no-op controls and must SURVIVE.
licfeat-gate-inverted	crates/mm-api/src/licensed_features.rs	        LicenceGate::Forward(response) => response,\n        LicenceGate::Unlicensed => {\n            ApiError::from(AppError::new(where_, id, None, String::new(), 501)).into_response()\n        }	        LicenceGate::Forward(_) => {\n            ApiError::from(AppError::new(where_, id, None, String::new(), 501)).into_response()\n        }\n        LicenceGate::Unlicensed => {\n            ApiError::from(AppError::new(where_, id, None, String::new(), 501)).into_response()\n        }	api	licensed_features
licfeat-refusal-is-a-403	crates/mm-api/src/licensed_features.rs	ApiError::from(AppError::new(where_, id, None, String::new(), 501)).into_response()	ApiError::from(AppError::new(where_, id, None, String::new(), 403)).into_response()	api	licensed_features
licfeat-flagging-error-id-changed	crates/mm-api/src/licensed_features.rs	const CONTENT_FLAGGING_LICENSE_ERROR: &str = "api.data_spillage.error.license";	const CONTENT_FLAGGING_LICENSE_ERROR: &str = "api.data_spillage.error.disabled";	api	licensed_features
