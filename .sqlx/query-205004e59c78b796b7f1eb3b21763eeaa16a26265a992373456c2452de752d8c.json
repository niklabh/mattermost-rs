{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id,\n                   token,\n                   createat,\n                   expiresat,\n                   lastactivityat,\n                   userid,\n                   deviceid,\n                   voipdeviceid,\n                   roles,\n                   isoauth,\n                   props,\n                   expirednotify\n              FROM sessions\n             WHERE userid = $1\n               AND expiresat <> 0\n               AND expiresat >= $2\n               AND ((deviceid <> '' AND deviceid != COALESCE(props->>'last_removed_device_id', ''))\n                 OR (voipdeviceid <> '' AND voipdeviceid != COALESCE(props->>'last_removed_voip_device_id', '')))\n            ",
