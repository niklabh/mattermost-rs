{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id        AS \"id!\",\n                   createat  AS \"create_at!\",\n                   updateat  AS \"update_at!\",\n                   deleteat  AS \"delete_at!\",\n                   creatorid AS \"creator_id!\",\n                   name      AS \"name!\"\n              FROM emoji\n             WHERE deleteat = 0\n               AND name LIKE $1\n             ORDER BY name\n             LIMIT $2\n            ",
