{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id,\n                   token,\n                   createat,\n                   expiresat,\n                   lastactivityat,\n                   userid,\n                   deviceid,\n                   voipdeviceid,\n                   roles,\n                   isoauth,\n                   props,\n                   expirednotify\n              FROM sessions\n             WHERE expiresat <> 0\n               AND expiresat < $1\n               AND expiresat > $2\n               AND (NOT $3 OR deviceid <> '')\n               AND (NOT $4 OR expirednotify <> true)\n            ",
