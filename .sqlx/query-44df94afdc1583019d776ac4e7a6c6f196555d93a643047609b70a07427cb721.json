{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT tm.teamid,\n               tm.userid,\n               tm.roles,\n               tm.deleteat,\n               tm.schemeuser,\n               tm.schemeadmin,\n               tm.schemeguest,\n               tm.createat,\n               ts.defaultteamguestrole,\n               ts.defaultteamuserrole,\n               ts.defaultteamadminrole\n          FROM teammembers tm\n          LEFT JOIN teams t ON tm.teamid = t.id\n          LEFT JOIN schemes ts ON t.schemeid = ts.id\n         WHERE tm.userid = $1\n           AND ($2 = '' OR tm.teamid <> $2)\n           AND ($3 OR tm.deleteat = 0)\n        ",
