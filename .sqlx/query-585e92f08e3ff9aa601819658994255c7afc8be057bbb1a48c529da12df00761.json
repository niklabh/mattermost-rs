  "query": "\n            SELECT groupid AS \"groupid!\", userid AS \"userid!\",\n                   COALESCE(createat, 0) AS \"createat!\", COALESCE(deleteat, 0) AS \"deleteat!\"\n              FROM groupmembers\n             WHERE groupid = $1 AND userid = ANY($2) AND deleteat = 0\n            ",
