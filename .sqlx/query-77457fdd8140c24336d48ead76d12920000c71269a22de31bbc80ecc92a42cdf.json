{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT ug.id, ug.name, ug.displayname, ug.description, ug.source, ug.remoteid,\n                   ug.createat, ug.updateat, ug.deleteat, ug.allowreference,\n                   (SELECT COUNT(gm.userid) FROM groupmembers gm WHERE gm.groupid = ug.id)\n                       AS \"membercount!\"\n              FROM usergroups ug\n             WHERE ug.id = $1\n            ",
